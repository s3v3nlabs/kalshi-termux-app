# Kalshi API (never commit real values)
KALSHI_KEY_ID=
# Path to RSA private key PEM (chmod 600). Default: ./secrets/kalshi.key
KALSHI_KEY_PATH=secrets/kalshi.key

# API host switch:
#   external  -> https://external-api.kalshi.com   (recommended)
#   elections -> https://api.elections.kalshi.com (legacy shared host)
#   demo      -> https://demo-api.kalshi.co
KALSHI_HOST=external

# Boot default only when no saved PAPER|LIVE choice exists.
# 0 = LIVE (default). 1 = PAPER. The top strip switch saves the choice on the phone.
DRY_RUN=0
# Fractional Kelly (0.25–0.5 typical). Hard max fraction of bankroll per trade.
KELLY_FRACTION=0.5
KELLY_MAX_FRACTION=0.05

# Scanner
SCAN_LIMIT=100
CACHE_TTL_SECONDS=10
MAX_CONTRACT_PRICE_CENTS=40
MIN_PAYOUT_MULTIPLE=2.0

# Server
# 127.0.0.1 = this phone only (recommended). 0.0.0.0 = anyone on your Wi-Fi can reach LIVE mode.
HOST=127.0.0.1
PORT=8787

# Optional: passphrase unlocks encrypted vault (or enter via Settings UI)
# VAULT_PASSPHRASE=

# Geo-gate for sports contracts (fail closed). Termux on 127.0.0.1 needs your
# two-letter state here, or every sports ticker is blocked.
# GEO_LOCAL_STATE=PA

# Auto-bet (OFF until you tap AUTO in the app; real orders when mode is LIVE and keys exist)
# AUTOBET_INTERVAL_S=30
# AUTOBET_TOP_N=5
# AUTOBET_PAPER_BANKROLL=1000

# Continuous learning: ingest settled markets, settle bets, gated refit
# LEARN_ENABLED=1
# LEARN_INTERVAL_H=6

# Set 0 to run the server without the auto-bet / learning loops
# BACKGROUND_TASKS=1
