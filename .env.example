# Kalshi API (never commit real values)
KALSHI_KEY_ID=
# Path to your Kalshi private key PEM, Ed25519 or RSA (chmod 600). Default: ./secrets/kalshi.key
KALSHI_KEY_PATH=secrets/kalshi.key

# API host switch:
#   external  -> https://external-api.kalshi.com   (recommended)
#   elections -> https://api.elections.kalshi.com (legacy shared host)
#   demo      -> https://demo-api.kalshi.co
KALSHI_HOST=external

# Boot default only when no saved PAPER|LIVE choice exists.
# 0 = LIVE (default). 1 = PAPER. The top strip switch saves the choice on the phone.
DRY_RUN=0
# Fractional Kelly (0.25–0.5 typical). Hard max fraction of bankroll per trade.
KELLY_FRACTION=0.5
KELLY_MAX_FRACTION=0.05

# Scanner
SCAN_LIMIT=100
CACHE_TTL_SECONDS=10
MAX_CONTRACT_PRICE_CENTS=40
MIN_PAYOUT_MULTIPLE=2.0

# Server
# 127.0.0.1 = this phone only (recommended). 0.0.0.0 = anyone on your Wi-Fi can reach LIVE mode.
HOST=127.0.0.1
PORT=8787

# Optional: passphrase unlocks encrypted vault (or enter via Settings UI)
# VAULT_PASSPHRASE=

# Geo-gate for sports contracts (fail closed). Termux on 127.0.0.1 needs your
# two-letter state here, or every sports ticker is blocked.
# GEO_LOCAL_STATE=PA

# Auto-bet (OFF until you tap AUTO in the app; real orders when mode is LIVE and keys exist)
# AUTOBET_INTERVAL_S=30
# AUTOBET_TOP_N=5
# AUTOBET_PAPER_BANKROLL=1000

# Continuous learning: ingest settled markets, settle bets, gated refit
# LEARN_ENABLED=1
# LEARN_INTERVAL_H=6

# Set 0 to run the server without the auto-bet / learning loops
# BACKGROUND_TASKS=1

# ---- Speed pack (v1.3.0) ----
# One key, one shared request budget sized from GET /account/limits.
# No proxies, extra keys, or IP tricks: those break Kalshi's terms and get accounts banned.
# RATE_SAFETY=0.85            # use 85% of your tier's token refill
# KALSHI_MAX_RPS=25           # extra global pacing cap (requests/second)
# WS_ENABLED=1                # WebSocket price/fill feed (falls back to REST polling)
# WS_WATCH_SCAN_N=120         # top scanner rows pushed live
# EXCHANGE_STATUS_TTL_S=15    # trading_active gate cache
# FEE_ROUND=0.01              # fee rounding: 0.01 = cent (conservative), 0.0001 = centicent
# Near-finish sniper (OFF until you enable it in Settings -> Speed)
# SNIPER_EV_MIN=0.03          # min net edge per contract after fees (dollars)
# SNIPER_NEAR_FRAC=0.25       # last 25% of regulation
# SNIPER_CANCEL_S=20          # cancel unfilled sniper orders after N seconds
# SNIPER_MAX_ORDERS=3         # per cycle
# SNIPER_INTERVAL_S=15
# SNIPER_FAST_INTERVAL_S=3
# Scoring pool: auto = processes, falling back to threads; thread | process | off
# COMPUTE_POOL=auto
# COMPUTE_WORKERS=            # default: CPU cores
# Optional math-only helper you run yourself (tools/remote_compute_server.py).
# Gets game-state numbers only, never keys/orders/prices, and never calls Kalshi. Off when blank.
# REMOTE_COMPUTE_URL=
